<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SlideSetupActivity">

    <com.example.energy_learning_app.SlidePreviewView
        android:id="@+id/slidePreview"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewSlideHeightTitle"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="  高度 Height"
        android:textColor="#5A3600"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slidePreview" />

    <TextView
        android:id="@+id/textViewSlideHeight"
        style="@style/Text.Body"
        android:layout_width="75dp"
        android:layout_height="34dp"
        android:text="5.0 m   "
        android:textColor="#5A3600"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/slideHeight"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slideHeight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stepSize="0.5"
        android:value="5"
        android:valueFrom="0"
        android:valueTo="10"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewSlideHeightTitle" />


    <TextView
        android:id="@+id/textViewSlideAngleTitle"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  角度 Angle"
        android:textColor="#5A3600"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slideHeight" />

    <TextView
        android:id="@+id/textViewSlideAngle"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30 °      "
        android:textColor="#5A3600"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/slideAngle"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slideAngle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stepSize="0.5"
        android:value="5"
        android:valueFrom="0"
        android:valueTo="10"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewSlideAngleTitle" />


    <TextView
        android:id="@+id/textViewSlideMassTitle"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  質量 Mass"
        android:textColor="#5A3600"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slideAngle" />

    <TextView
        android:id="@+id/textViewSlideMass"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2 kg     "
        android:textColor="#5A3600"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/slideMass"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slideMass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stepSize="0.5"
        android:value="5"
        android:valueFrom="0"
        android:valueTo="10"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewSlideMassTitle" />

    <TextView
        android:id="@+id/textViewSlideFricTitle"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  摩擦係數 μ"
        android:textColor="#5A3600"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slideMass" />

    <TextView
        android:id="@+id/textViewSlideFric"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2.0       "
        android:textColor="#5A3600"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/slideFric"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slideFric"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stepSize="0.5"
        android:value="5"
        android:valueFrom="0"
        android:valueTo="10"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewSlideFricTitle" />

    <Button
        android:id="@+id/buttonSlideReset"
        style="@style/Widget.Button.Outlined.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="32dp"
        android:text="重置"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slideFric" />

    <Button
        android:id="@+id/buttonSlideNext"
        style="@style/Widget.Button.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="60dp"
        android:text="確認"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slideFric" />

</androidx.constraintlayout.widget.ConstraintLayout>